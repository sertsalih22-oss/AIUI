<Window x:Class="AIUI.AddCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Kategori Ekle" Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#F9FAFB"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Kategori Bilgileri" FontSize="18" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>

            <TextBlock Text="Başlık (Örn: C# Hata Çözümü)" Foreground="#4B5563" Margin="0,0,0,5"/>
            <TextBox x:Name="txtTitle" Padding="5" Height="30" Margin="0,0,0,15" BorderBrush="#D1D5DB" />
            <Button Content="Veritabanına Kaydet" Background="#10B981" Foreground="White" Height="35" BorderThickness="0" Cursor="Hand" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>